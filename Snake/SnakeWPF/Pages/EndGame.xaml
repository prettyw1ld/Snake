<Page x:Class="SnakeWPF.Pages.EndGame"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SnakeWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EndGame">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/home_bg.png"/>
        </Grid.Background>
        <Grid>
            <Grid Width="320"
                  Height="200"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                  <Grid.Background>
                    <ImageBrush ImageSource="/Images/home_card_bg.png"/>
                  </Grid.Background>
                <Label
                    x:Name="name"
                    Content="Alexshahka"
                    HorizontalAlignment="Center"
                    Margin="0,37,0,0"
                    VerticalAlignment="Top"
                    Foreground="Black"
                    FontFamily="Forte"
                    FontSize="16"/>
                <Label
                    x:Name="glasses"
                    Content="90 glasses"
                    Margin="0,50,0,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Center"
                    FontFamily="Forte"/>
                <Button Click="OpenHome"
                        Content="Main Menu"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15"
                        VerticalAlignment="Bottom"
                        Width="230"
                        Height="25" FontFamily="Forte"/>
                <Label x:Name="Top"
                       Content="999"
                       Margin="75"
                       VerticalAlignment="Top"
                       HorizontalContentAlignment="Center"
                       FontFamily="Forte"
                       VerticalContentAlignment="Center"
                       FontSize="24"/>

            </Grid>
        </Grid>
    </Grid>
</Page>
